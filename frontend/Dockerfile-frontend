FROM python:3.10
WORKDIR /app
ENV PYTHONPATH=/app

# Build context is the repo root (context: .), so paths are repo-relative
COPY frontend/requirements-frontend.txt .
RUN pip install --no-cache-dir -r requirements-frontend.txt

COPY frontend/ ./frontend
COPY common/ ./common
COPY auth/ ./auth

EXPOSE 8050
CMD ["python", "./frontend/app.py"]
